import pandas as pd
import numpy as np

df = pd.read_csv("GeneralEsportData.csv")

df = df.dropna(subset=["Genre"])

print("Genre distribution:")
print(df["Genre"].value_counts())

np.random.seed(42)

TARGET_SIZE = 75

genres = df["Genre"].unique()
num_genres = len(genres)

per_genre = max(1, TARGET_SIZE // num_genres)

balanced_sample = []

for genre in genres:
    
    genre_df = df[df["Genre"] == genre]
    
    sample = genre_df.sample(min(len(genre_df), per_genre))
    
    balanced_sample.append(sample)

balanced_df = pd.concat(balanced_sample)

if len(balanced_df) < TARGET_SIZE:
    
    remaining = TARGET_SIZE - len(balanced_df)
    
    extra = df[~df["Game"].isin(balanced_df["Game"])].sample(remaining)
    
    balanced_df = pd.concat([balanced_df, extra])

balanced_df = balanced_df.head(75).copy()

def competitive_level(row):
    
    if row["TotalEarnings"] >= 10000000 or row["TotalTournaments"] >= 500:
        return "High"
    
    elif row["TotalEarnings"] >= 1000000:
        return "Medium"
    
    else:
        return "Low"


def region_popularity(row):
    
    game = str(row["Game"]).lower()
    
    if "starcraft" in game:
        return "South Korea/Global"
    
    elif "league of legends" in game:
        return "Global"
    
    elif "counter" in game:
        return "Europe/Global"
    
    elif "dota" in game:
        return "Global"
    
    elif "fifa" in game:
        return "Europe/Global"
    
    elif "call of duty" in game or "halo" in game:
        return "North America"
    
    else:
        return "Global"


def notes(row):
    
    if row["TotalEarnings"] >= 20000000:
        return "Very large esports prize pool history"
    
    elif row["TotalTournaments"] >= 1000:
        return "Long running competitive scene"
    
    else:
        return "Established esports title"


balanced_df["CompetitiveLevel"] = balanced_df.apply(competitive_level, axis=1)
balanced_df["RegionPopularity"] = balanced_df.apply(region_popularity, axis=1)
balanced_df["Notes"] = balanced_df.apply(notes, axis=1)

final_df = balanced_df[
    [
        "Game",
        "ReleaseDate",
        "Genre",
        "TotalEarnings",
        "TotalPlayers",
        "TotalTournaments",
        "RegionPopularity",
        "CompetitiveLevel",
        "Notes"
    ]
]

final_df.to_csv("esports_games_bespoke.csv", index=False)

print("Dataset created!")
print("Rows:", len(final_df))
print(final_df.head())